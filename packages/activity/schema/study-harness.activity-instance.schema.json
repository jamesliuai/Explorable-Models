{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.activity-instance-1.0.json",
  "title": "Study Harness activity instance",
  "type": "object",
  "properties": {
    "contract": {
      "const": "study-harness.activity-instance"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "activityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "objectiveIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "maxItems": 32
    },
    "hostSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "hostSessionRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "template": {
      "$ref": "#/$defs/TemplateRef"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "initialParameters": {
      "$ref": "#/$defs/ParameterValues"
    },
    "mode": {
      "enum": [
        "approved",
        "exploratory"
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "enteredAtSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "enteredAtSequence"
      ],
      "additionalProperties": false
    },
    "activityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy": {
      "$ref": "#/$defs/PolicyRef"
    },
    "context": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "instructional"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "independent"
            },
            "taskRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "kind",
            "taskRef"
          ],
          "additionalProperties": false
        }
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResponseRef"
      },
      "maxItems": 256
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "enum": [
          "discover",
          "prepare",
          "inspect.learner",
          "inspect.tutor",
          "inspect.teacher",
          "propose-revision",
          "request-reveal",
          "operate.parameters",
          "operate.navigation",
          "operate.playback",
          "operate.presentation",
          "summarize",
          "save",
          "restore",
          "close",
          "sample",
          "compose.exploratory"
        ]
      },
      "maxItems": 32
    },
    "persistence": {
      "enum": [
        "saved",
        "saving",
        "pending-recovery",
        "failed"
      ]
    },
    "closed": {
      "type": "boolean"
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "activityId",
    "objectiveIds",
    "hostSessionId",
    "hostSessionRevision",
    "template",
    "model",
    "initialParameters",
    "mode",
    "stage",
    "activityRevision",
    "policy",
    "context",
    "responses",
    "allowedActions",
    "persistence",
    "closed"
  ],
  "additionalProperties": false,
  "$defs": {
    "ModelRef": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "modelId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ParameterValues": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": -1000000000000000,
        "maximum": 1000000000000000
      },
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "PolicyRef": {
      "type": "object",
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "policyId",
        "revision"
      ],
      "additionalProperties": false
    },
    "ResponseRef": {
      "type": "object",
      "properties": {
        "responseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "taskRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "prediction",
            "explanation",
            "answer"
          ]
        },
        "modality": {
          "enum": [
            "speech-derived",
            "text",
            "numeric",
            "choice",
            "diagram"
          ]
        },
        "stageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "status": {
          "enum": [
            "submitted",
            "superseded",
            "corrected",
            "disputed",
            "deleted"
          ]
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "responseId",
        "taskId",
        "taskRevision",
        "kind",
        "modality",
        "stageId",
        "status"
      ],
      "additionalProperties": false
    },
    "TemplateRef": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "templateId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
