{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.journal-cursor-1.0.json",
  "title": "Study Harness journal cursor",
  "type": "object",
  "properties": {
    "activityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastEventId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpointDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "activityId",
    "lastSequence",
    "lastEventId",
    "checkpointDigest"
  ],
  "additionalProperties": false
}
