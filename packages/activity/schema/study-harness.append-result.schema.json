{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.append-result-1.0.json",
  "title": "Study Harness append result",
  "type": "object",
  "properties": {
    "acknowledged": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "durableSequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "hostTimestamp": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "eventId",
          "durableSequence",
          "hostTimestamp"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "maxItems": 32
    },
    "cursor": {
      "$ref": "#/$defs/JournalCursor"
    }
  },
  "required": [
    "acknowledged",
    "duplicates",
    "cursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "JournalCursor": {
      "type": "object",
      "properties": {
        "activityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastEventId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointDigest": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activityId",
        "lastSequence",
        "lastEventId",
        "checkpointDigest"
      ],
      "additionalProperties": false
    }
  }
}
