{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.review-record-1.0.json",
  "title": "Study Harness review record",
  "type": "object",
  "properties": {
    "contract": {
      "const": "study-harness.review-record"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "model"
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 48,
              "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
            },
            "scientificRevision": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "modelId",
            "version",
            "scientificRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "template"
            },
            "templateId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 48,
              "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
            },
            "contentDigest": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "templateId",
            "version",
            "contentDigest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "affiliation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 32
    },
    "referenceSuiteDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "approved",
        "approved-with-limitations",
        "rejected"
      ]
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "reviewId",
    "subject",
    "reviewer",
    "date",
    "scope",
    "limitations",
    "referenceSuiteDigest",
    "outcome"
  ],
  "additionalProperties": false
}
