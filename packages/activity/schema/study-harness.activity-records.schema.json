{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.activity-records-1.0.json",
  "title": "Study Harness activity records",
  "type": "object",
  "properties": {
    "activityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "exposures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExposureRecord"
      },
      "maxItems": 256
    },
    "assistance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssistanceRef"
      },
      "maxItems": 256
    },
    "activity": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "activityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "closed": {
          "type": "boolean"
        },
        "lineage": {
          "type": "object",
          "properties": {
            "context": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "instructional"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "independent"
                    },
                    "taskRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    }
                  },
                  "required": [
                    "kind",
                    "taskRef"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "fromActivityRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "context",
            "fromActivityRevision"
          ],
          "additionalProperties": false
        },
        "stageReceiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      },
      "required": [
        "stage",
        "activityRevision",
        "closed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "activityId",
    "exposures",
    "assistance"
  ],
  "additionalProperties": false,
  "$defs": {
    "AssistanceRef": {
      "type": "object",
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "help",
            "reopen-instructional"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grant": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "exposureId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "maxItems": 64,
                  "minItems": 1
                }
              },
              "required": [
                "exposureId",
                "groups"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "receiptId",
        "kind",
        "sequence",
        "grant"
      ],
      "additionalProperties": false
    },
    "ExposureRecord": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "study-harness.exposure-record"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "exposureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "activityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "receiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "scope": {
          "enum": [
            "stage",
            "reveal",
            "exploration"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupDigest"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "template": {
          "$ref": "#/$defs/TemplateRef"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "activityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intendedStage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "parameterDomain": {
          "$ref": "#/$defs/ParameterDomain"
        },
        "displayStatus": {
          "enum": [
            "authorized",
            "displayed",
            "uncertain",
            "not-displayed"
          ]
        },
        "displayed": {
          "type": "object",
          "properties": {
            "projectionDigest": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "frameId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "monotonicMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            "endedMonotonicMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            "endedBy": {
              "enum": [
                "stage",
                "independent",
                "policy",
                "revoked",
                "closed"
              ]
            }
          },
          "required": [
            "projectionDigest",
            "frameId",
            "monotonicMs"
          ],
          "additionalProperties": false
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "ACK_NOT_PERSISTED",
                "INTERRUPTED_BEFORE_ACK",
                "SURFACE_LOST"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "schemaVersion",
        "exposureId",
        "activityId",
        "receiptId",
        "scope",
        "groups",
        "template",
        "model",
        "activityRevision",
        "intendedStage",
        "displayStatus"
      ],
      "additionalProperties": false
    },
    "GroupDigest": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "contentDigest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "groupId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "modelId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ParameterDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "maxItems": 2,
        "minItems": 2
      },
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "TemplateRef": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "templateId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
