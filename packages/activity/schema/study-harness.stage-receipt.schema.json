{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/study-harness.stage-receipt-1.0.json",
  "title": "Study Harness stage receipt",
  "type": "object",
  "properties": {
    "contract": {
      "const": "study-harness.stage-receipt"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "activityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "basedOnActivityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "template": {
      "$ref": "#/$defs/TemplateRef"
    },
    "model": {
      "$ref": "#/$defs/ModelRef"
    },
    "issuedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fromStage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "toStage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExposureGrant"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "receiptId",
    "activityId",
    "basedOnActivityRevision",
    "activityRevision",
    "policyId",
    "policyRevision",
    "idempotencyKey",
    "template",
    "model",
    "issuedAt",
    "expiresAt",
    "fromStage",
    "toStage",
    "grant"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExposureGrant": {
      "type": "object",
      "properties": {
        "exposureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "scope": {
          "enum": [
            "stage",
            "reveal",
            "exploration"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupDigest"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "parameterDomain": {
          "$ref": "#/$defs/ParameterDomain"
        }
      },
      "required": [
        "exposureId",
        "scope",
        "groups"
      ],
      "additionalProperties": false
    },
    "GroupDigest": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "contentDigest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "groupId",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "modelId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ParameterDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "maxItems": 2,
        "minItems": 2
      },
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "TemplateRef": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "templateId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
