{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explorable-models.invalid/schema/study-harness.host-policy-1.0.json",
  "title": "Study Harness host policy",
  "type": "object",
  "properties": {
    "contract": {
      "const": "study-harness.host-policy"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "approved",
        "exploratory"
      ]
    },
    "approved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "$ref": "#/$defs/TemplateRef"
          },
          "model": {
            "$ref": "#/$defs/ModelRef"
          }
        },
        "required": [
          "template",
          "model"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "enum": [
          "discover",
          "prepare",
          "inspect.learner",
          "inspect.tutor",
          "inspect.teacher",
          "propose-revision",
          "request-reveal",
          "operate.parameters",
          "operate.navigation",
          "operate.playback",
          "operate.presentation",
          "summarize",
          "save",
          "restore",
          "close",
          "sample",
          "compose.exploratory"
        ]
      },
      "maxItems": 32
    },
    "visibleGroups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "maxItems": 64
    },
    "permittedControls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "maxItems": 64
    },
    "export": {
      "type": "object",
      "properties": {
        "learnerSnapshot": {
          "type": "boolean"
        },
        "capture": {
          "type": "boolean"
        },
        "backup": {
          "type": "boolean"
        }
      },
      "required": [
        "learnerSnapshot",
        "capture",
        "backup"
      ],
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "properties": {
        "developer": {
          "type": "boolean"
        },
        "tutor": {
          "enum": [
            "learner-visible",
            "full"
          ]
        },
        "teacher": {
          "type": "boolean"
        }
      },
      "required": [
        "developer",
        "tutor",
        "teacher"
      ],
      "additionalProperties": false
    },
    "independentTask": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "taskRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "permittedTools": {
          "type": "array",
          "items": {
            "enum": [
              "discover",
              "prepare",
              "inspect.learner",
              "inspect.tutor",
              "inspect.teacher",
              "propose-revision",
              "request-reveal",
              "operate.parameters",
              "operate.navigation",
              "operate.playback",
              "operate.presentation",
              "summarize",
              "save",
              "restore",
              "close",
              "sample",
              "compose.exploratory"
            ]
          },
          "maxItems": 32
        },
        "neutralScaffold": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "maxItems": 64
        }
      },
      "required": [
        "active",
        "taskRef",
        "permittedTools",
        "neutralScaffold"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "maxPositions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "allowed",
        "maxPositions"
      ],
      "additionalProperties": false
    },
    "exploratory": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "maxParametersOverride": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      },
      "required": [
        "allowed",
        "maxParametersOverride"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "schemaVersion",
    "policyId",
    "revision",
    "issuedAt",
    "expiresAt",
    "revoked",
    "mode",
    "approved",
    "allowedTools",
    "visibleGroups",
    "permittedControls",
    "export",
    "inspection",
    "independentTask",
    "sampling",
    "exploratory"
  ],
  "additionalProperties": false,
  "$defs": {
    "ModelRef": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "modelId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "TemplateRef": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        },
        "digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "templateId",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
