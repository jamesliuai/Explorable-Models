    "id": "riemann-v2",
    "title": "A small error is still a value",
    "description": "The midpoint approximation of x² on [0,1], with the signed error kept visible.",
    "parameters": {
      "n": {
        "label": "Subdivisions",
        "value": 100,
        "min": 1,
        "max": 1000,
        "step": 1,
        "unit": "",
        "integer": true
      }
    },
    "quantities": {
      "integral": {
        "expression": "1/3",
        "label": "Exact integral"
      },
      "approximation": {
        "expression": "(4*n*n-1)/(12*n*n)",
        "label": "Midpoint sum"
      },
      "error": {
        "expression": "approximation-integral",
        "label": "Signed error"
      }
    },
    "series": {
      "curve": {
        "label": "Integrand x²",
