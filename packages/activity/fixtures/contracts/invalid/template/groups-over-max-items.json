    "views": [
      {
        "id": "plot",
        "kind": "plot2d",
        "group": "g-plot",
        "title": "Loss and iterates",
        "description": "Plot of the loss a·x²/2 against x, with the descent iterates drawn on the curve.",
        "bounds": [
          -10,
          10,
          -5,
          55
        ],
        "equalAspect": false,
        "axes": {
          "x": {
            "label": "Position x",
            "unit": "dimensionless",
            "quantity": "x"
          },
          "y": {
            "label": "Loss f(x)",
            "unit": "dimensionless",
            "quantity": "loss"
          }
        },
        "marks": [
          {
            "id": "m-curve",
            "kind": "curve",
            "group": "g-landscape",
            "label": "Loss curve",
            "bindings": {
              "geometry": "landscape"
            },
            "style": {
              "role": "primary",
              "dash": "solid",
              "marker": "none",
              "weight": "regular"
            }
          },
          {
            "id": "m-start",
            "kind": "point",
