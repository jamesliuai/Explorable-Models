        "marks": [],
        "equations": [
          "eq-update"
        ]
      },
      {
        "id": "table",
        "kind": "table",
        "group": "g-table",
        "title": "Iterates",
        "description": "One row per iterate: index, position and loss.",
        "equalAspect": false,
        "marks": [],
        "rowsFrom": "iterates"
      }
    ],
    "controls": [
      {
        "parameter": "eta",
        "group": "g-controls",
        "label": "Learning rate η",
        "displayUnits": [
          "dimensionless"
        ],
        "slider": true,
        "exact": true,
        "step": 0.05,
        "description": "Step size multiplying the gradient."
      },
      {
        "parameter": "x0",
        "group": "g-controls",
        "label": "Starting point x₀",
        "displayUnits": [
          "dimensionless"
        ],
        "slider": true,
        "exact": true,
        "step": 0.5,
        "description": "Position before the first step."
      },
      {
        "parameter": "a",
        "group": "g-controls",
        "label": "Curvature a",
        "displayUnits": [
          "dimensionless"
        ],
        "slider": true,
        "exact": true,
        "step": 0.1,
        "description": "Curvature of the loss."
      }
    ],
    "scenarios": [
      {
        "id": "s-monotone",
        "label": "Small steps",
        "description": "η·a = 0.5: steady approach to the minimum.",
        "parameters": {
          "eta": 0.5,
          "a": 1,
          "x0": 8
        },
        "group": "g-controls"
      },
      {
        "id": "s-diverge",
        "label": "Large steps",
        "description": "η·a = 3: every step overshoots further.",
        "parameters": {
          "eta": 2,
          "a": 1.5,
          "x0": 8
        },
        "group": "g-controls"
      }
    ],
    "equations": [
      {
        "id": "eq-update",
        "group": "g-rule",
        "label": "Update rule",
        "tex": "x_{n+1} = (1 - \\eta a)\\,x_n = {{q:multiplier}} \\times {{q:x}}",
        "plain": "x next = (1 − η·a)·x = {{q:multiplier}} × {{q:x}}"
      }
    ],
    "stages": [
      {
        "id": "predict",
        "kind": "predict",
        "instruction": "Choose a learning rate and predict whether the iterates will settle at the minimum.",
        "visible": {
          "g-plot": "fixed",
          "g-landscape": "fixed",
          "g-controls": "interactive",
          "g-alternatives": "fixed",
          "g-notes": "fixed"
        },
        "controls": {
          "eta": "interactive",
          "x0": "fixed",
          "a": "fixed"
        },
        "allowsPreview": false,
        "allowsPlayback": false,
        "allowsNavigation": false,
        "response": {
          "kind": "prediction",
          "prompt": "Will the iterates converge, oscillate or diverge for your learning rate?",
          "taskFamily": "tf-regime"
        }
      },
      {
        "id": "explore",
        "kind": "explore",
        "instruction": "Step through the iterates and try other learning rates.",
        "visible": {
          "g-plot": "interactive",
          "g-landscape": "interactive",
          "g-trajectory": "interactive",
          "g-position": "fixed",
          "g-multiplier": "fixed",
          "g-values": "fixed",
          "g-equation-view": "fixed",
          "g-rule": "fixed",
          "g-table": "fixed",
          "g-controls": "interactive",
          "g-alternatives": "fixed",
          "g-notes": "fixed"
        },
        "controls": {
          "eta": "interactive",
          "x0": "interactive",
          "a": "interactive"
        },
        "allowsPreview": true,
        "allowsPlayback": true,
        "allowsNavigation": true
      },
