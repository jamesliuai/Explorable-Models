            "label": "Starting point",
            "bindings": {
              "at": "start"
            },
            "style": {
              "role": "reference",
              "dash": "solid",
              "marker": "circle",
              "weight": "regular"
            },
            "drag": {
              "x": "x0"
            }
          },
          {
            "id": "m-iterates",
            "kind": "points",
            "group": "g-trajectory",
            "label": "Iterates",
            "bindings": {
              "geometry": "iterates"
            },
            "style": {
              "role": "accent",
              "dash": "solid",
              "marker": "circle",
              "weight": "regular"
            }
          },
          {
            "id": "m-steps",
            "kind": "segments",
            "group": "g-trajectory",
            "label": "Steps",
            "bindings": {
              "geometry": "steps"
            },
            "style": {
              "role": "muted",
              "dash": "dashed",
              "marker": "none",
              "weight": "thin"
            }
          },
          {
            "id": "m-point",
            "kind": "point",
            "group": "g-trajectory",
            "label": "Current iterate",
            "bindings": {
              "at": "point"
            },
            "style": {
              "role": "accent",
              "dash": "solid",
              "marker": "circle",
              "weight": "bold"
            }
          },
          {
            "id": "m-label",
            "kind": "label",
            "group": "g-trajectory",
            "label": "Current iterate label",
            "bindings": {
              "at": "point"
            },
            "style": {
              "role": "accent",
              "dash": "solid",
              "marker": "none",
              "weight": "regular"
            },
            "text": "x_n",
            "placement": {
              "anchor": "ne",
              "offset": [
                6,
                -6
              ],
              "leader": false,
              "maxWidthEm": 8
            }
          }
        ]
      },
      {
        "id": "values",
        "kind": "values",
        "group": "g-values",
        "title": "Current values",
