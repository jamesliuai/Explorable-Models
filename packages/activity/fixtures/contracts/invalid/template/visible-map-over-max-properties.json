{
  "contract": "study-harness.activity-template",
  "expect": "invalid",
  "why": "A stage lists at most 64 visible groups.",
  "value": {
    "contract": "study-harness.activity-template",
    "schemaVersion": "1.0",
    "templateId": "quadratic-descent-regimes",
    "version": "1.0.0",
    "model": {
      "modelId": "quadratic-descent",
      "version": "1.0.0",
      "digest": "sha256:5628bdae56bfc31447adfef3c4acb42a8eccf7d1fd34940061f37a633e270901"
    },
    "title": "How the learning rate shapes gradient descent",
    "purpose": "Predict, then observe, how the step product η·a determines whether fixed-step descent converges, oscillates or diverges.",
    "dimension": "2d",
    "locale": "en-GB",
    "requires": [
      {
        "id": "discrete-iteration",
        "version": "1.0"
      }
    ],
    "groups": [
      {
        "id": "g-plot",
        "kind": "view",
        "label": "Loss plot",
        "description": "The loss curve and the descent path.",
        "solutionBearing": false,
        "members": [
          "plot"
        ]
      },
      {
        "id": "g-landscape",
        "kind": "mark",
        "label": "Loss curve",
        "description": "The quadratic loss and the draggable start.",
        "solutionBearing": false,
        "members": [
          "m-curve",
          "m-start"
        ]
      },
      {
        "id": "g-trajectory",
        "kind": "mark",
        "label": "Descent path",
        "description": "Iterates, steps and the current point.",
        "solutionBearing": true,
        "members": [
          "m-iterates",
          "m-steps",
          "m-point",
          "m-label"
        ]
      },
      {
        "id": "g-position",
        "kind": "quantity",
        "label": "Position and loss",
        "description": "Current iterate and its loss.",
        "solutionBearing": true,
        "members": [
          "x",
          "loss",
          "point"
        ]
      },
      {
        "id": "g-multiplier",
        "kind": "quantity",
        "label": "Step multiplier",
        "description": "r = 1 − η·a.",
        "solutionBearing": false,
        "members": [
          "multiplier",
          "start"
        ]
      },
      {
        "id": "g-values",
        "kind": "view",
        "label": "Values",
        "description": "Numeric readout.",
        "solutionBearing": false,
        "members": [
          "values"
        ]
      },
      {
        "id": "g-equation-view",
        "kind": "view",
        "label": "Update rule view",
        "description": "The update rule with current numbers.",
        "solutionBearing": false,
        "members": [
          "equation"
        ]
      },
      {
        "id": "g-rule",
        "kind": "equation",
        "label": "Update rule",
        "description": "x_{n+1} = r·x_n with values.",
