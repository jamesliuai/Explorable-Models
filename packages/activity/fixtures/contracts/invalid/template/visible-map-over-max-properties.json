        "members": [
          "table"
        ]
      },
      {
        "id": "g-controls",
        "kind": "control",
        "label": "Parameters",
        "description": "Learning rate, start and curvature.",
        "solutionBearing": false,
        "members": [
          "eta",
          "x0",
          "a"
        ]
      },
      {
        "id": "g-alternatives",
        "kind": "alternative",
        "label": "Accessible equivalents",
        "description": "Text, table and keyboard equivalents.",
        "solutionBearing": false,
        "members": [
          "alt-description",
          "alt-table",
          "alt-keyboard"
        ]
      },
      {
        "id": "g-notes",
        "kind": "annotation",
        "label": "Notes",
        "description": "Derivation and assumptions.",
        "solutionBearing": false,
        "members": [
          "note-derivation",
          "note-assumption"
        ]
      }
