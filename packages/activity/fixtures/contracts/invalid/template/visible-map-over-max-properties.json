        "slider": true,
        "exact": true,
        "step": 0.05,
        "description": "Step size multiplying the gradient."
      },
      {
        "parameter": "x0",
        "group": "g-controls",
        "label": "Starting point x₀",
        "displayUnits": [
          "dimensionless"
        ],
        "slider": true,
        "exact": true,
        "step": 0.5,
        "description": "Position before the first step."
      },
      {
        "parameter": "a",
        "group": "g-controls",
        "label": "Curvature a",
        "displayUnits": [
          "dimensionless"
        ],
        "slider": true,
        "exact": true,
        "step": 0.1,
        "description": "Curvature of the loss."
      }
    ],
    "scenarios": [
      {
        "id": "s-monotone",
        "label": "Small steps",
        "description": "η·a = 0.5: steady approach to the minimum.",
        "parameters": {
          "eta": 0.5,
          "a": 1,
          "x0": 8
        },
        "group": "g-controls"
      },
      {
        "id": "s-diverge",
        "label": "Large steps",
        "description": "η·a = 3: every step overshoots further.",
        "parameters": {
          "eta": 2,
          "a": 1.5,
          "x0": 8
        },
        "group": "g-controls"
      }
    ],
    "equations": [
