{
  "name": "@explorable-models/study-harness-tauri-spike-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Packaged Tauri 2 reference host skeleton for the Study Harness visualizer (W12 native feasibility spike). Not part of the root workspaces.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.mjs",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app --no-sign",
    "spike": "node scripts/run-spike.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
