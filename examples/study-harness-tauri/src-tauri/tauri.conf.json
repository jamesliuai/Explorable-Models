{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StudyHarnessReference",
  "version": "0.1.0",
  "identifier": "dev.explorablemodels.studyharness.reference",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src 'self' ipc:; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Education",
    "shortDescription": "Study Harness visualizer reference host (conformance fixture)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
