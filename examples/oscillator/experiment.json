      "advanced": false
    },
    "periods": {
      "type": "number",
      "label": "Observation periods",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "1",
      "advanced": true,
      "integer": true
    }
  },
