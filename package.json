{
  "name": "@experiment-kit/workspace",
  "version": "0.2.0-preview.1",
  "private": true,
  "type": "module",
  "description": "Explorable Models: an inspectable, reproducible interactive explanation toolkit for developers and agents.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/revisions.mjs && vite --host 127.0.0.1",
    "build": "node scripts/revisions.mjs && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "ek": "tsx packages/cli/src/index.ts",
    "kit": "node packages/cli/bin/experiment-kit.mjs",
    "build:sdk": "npm run build --workspace @experiment-kit/core",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "release": "node scripts/package-release.mjs",
    "start": "vite preview --host 127.0.0.1",
    "build:packages": "npm run build:sdk && npm run build --workspace @experiment-kit/player && npm run build --workspace @experiment-kit/agent && node scripts/generate-api.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "release:preview": "npm run verify:preview && node scripts/package-preview.mjs && npm run verify:artifacts",
    "test:cross-browser": "EXPERIMENT_KIT_CROSS_BROWSER=1 playwright test composition.spec.ts embedding-renderer.spec.ts",
    "verify:preview": "node scripts/verify-preview.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "preflight:public": "node scripts/check-publication.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesliuai/Explorable-Models.git"
  },
  "homepage": "https://github.com/jamesliuai/Explorable-Models#readme",
  "bugs": {
    "url": "https://github.com/jamesliuai/Explorable-Models/issues"
  }
}
