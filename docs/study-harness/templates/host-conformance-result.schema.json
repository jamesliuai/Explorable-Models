{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.dev/schema/study-harness/host-conformance-result-1.json",
  "title": "Study Harness host conformance result (external gate G2, A54)",
  "description": "One run of the G2 conformance sequence against a host. subject labels whether the run used the actual Study Harness application or a fixture host (the packaged reference host or an in-memory host); fixture results never satisfy A54. Every step of the sequence is listed, with not-run and not-run (environment) kept distinct from pass. Do not put learner data, study content or credentials in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "runAt",
    "host",
    "packages",
    "steps",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "study-harness.host-conformance-result/1"
    },
    "subject": {
      "enum": [
        "actual-host",
        "reference-fixture-host",
        "memory-fixture-host"
      ]
    },
    "runAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit",
        "dirty",
        "binarySha256",
        "platform"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+-]{0,127}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "binarySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed": {
          "type": "boolean"
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "osVersion",
            "arch"
          ],
          "properties": {
            "os": {
              "enum": [
                "macOS",
                "Windows",
                "Linux"
              ]
            },
            "osVersion": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._ ()-]{0,63}$"
            },
            "arch": {
              "enum": [
                "arm64",
                "x64"
              ]
            },
            "webview": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@experiment-kit/[a-z0-9-]{1,32}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "description": "The conformance kit that produced this record (for example @experiment-kit/activity/conformance); absent when the host ran the sequence with its own harness.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9][A-Za-z0-9_.:@/+-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}(-[0-9A-Za-z.-]{1,32})?$"
        }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open-quadratic",
        "prediction-reference",
        "authorize-reveal",
        "commit-exploration",
        "camera-change",
        "save",
        "terminate",
        "reopen-verify",
        "independent-task",
        "crash-before-intent",
        "crash-after-intent",
        "crash-after-display"
