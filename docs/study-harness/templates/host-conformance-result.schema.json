        "open-quadratic": {
          "description": "Open the quadratic activity from the approved catalogue through the host",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "pass",
                "fail",
                "not-run (environment)",
                "not-run"
              ]
            },
            "assertions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "outcome"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+-]{0,127}$"
                  },
                  "outcome": {
                    "enum": [
                      "pass",
                      "fail",
                      "not-run (environment)",
                      "not-run"
                    ]
                  },
                  "detail": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "Why the assertion failed or did not run (fixed text with codes and counts; no learner data)."
                  }
                }
              }
            },
            "environmentReason": {
              "type": "string",
              "maxLength": 300
            },
            "reason": {
              "type": "string",
              "maxLength": 300,
              "description": "Why the step did not run or failed (for example a missing host hook or an earlier failed step)."
            },
            "evidence": {
              "type": "string",
              "maxLength": 300,
              "description": "Path or reference to the host-side log or capture (no learner data)."
            }
          }
        },
