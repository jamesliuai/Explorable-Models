{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://experiment-kit.invalid/schema/document-2.0.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 4000,
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 0
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "minimum": 5e-324
          },
          "integer": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "maxLength": 80
          },
          "dimension": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          }
        },
        "required": [
          "label",
          "value",
          "min",
          "max"
        ],
        "additionalProperties": false
      },
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
      }
    },
    "quantities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "expression": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 256,
                "minItems": 2
              }
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "maxLength": 80
          },
          "dimension": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "expression"
        ],
        "additionalProperties": false
      },
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.][A-Za-z_][A-Za-z0-9_]*)*$"
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 16,
            "minItems": 1
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "maxItems": 16,
              "minItems": 1
            },
            "maxItems": 5000,
            "minItems": 0
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1
          }
        },
        "required": [
          "columns",
          "rows",
          "description"
        ],
        "additionalProperties": false
      },
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "x": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1
          },
          "y": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1
          },
          "variable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "domain": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "samples": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2000
          },
          "dataset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "xColumn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "yColumn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "model",
              "observed"
            ]
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "type": {
            "enum": [
              "scene",
              "plot",
              "values",
              "equation",
              "table"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "marks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mark"
            },
            "maxItems": 256,
            "minItems": 0
          },
          "quantities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "maxItems": 128,
            "minItems": 0
          },
          "equation": {
            "type": "string",
            "maxLength": 4000
          },
          "dataset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4
          },
          "equalAspect": {
            "type": "boolean"
          },
          "xLabel": {
            "type": "string",
            "maxLength": 200
          },
          "yLabel": {
            "type": "string",
            "maxLength": 200
          },
          "scale": {
            "enum": [
              "linear",
              "log"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
    },
    "time": {
      "type": "object",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 256,
              "minItems": 2
            }
          ]
        },
        "step": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1000
        }
      },
      "required": [
        "end"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "columns": {
          "enum": [
            1,
            2
          ]
        },
        "controls": {
          "type": "boolean"
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "locale": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1
      },
      "maxItems": 64,
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1
      },
      "maxItems": 64,
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000,
        "minLength": 1
      },
      "maxItems": 64,
      "minItems": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authoredBy": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "review": {
          "const": "unreviewed"
        },
        "checks": {
          "enum": [
            "author",
            "none"
          ]
        }
      },
      "required": [
        "review"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "parameters",
    "quantities",
    "views",
    "assumptions",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "mark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "point",
            "segment",
            "path",
            "polygon",
            "circle",
            "ellipse",
            "arrow",
            "angle",
            "label",
            "line",
            "scatter",
            "bar",
            "region",
            "group"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "maxProperties": 12,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          }
        },
        "series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "style": {
          "type": "object",
          "properties": {
            "stroke": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "fill": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "dash": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hidden": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          },
          "maxItems": 256,
          "minItems": 0
        },
        "drag": {
          "type": "object",
          "properties": {
            "x": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "y": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "semanticId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
