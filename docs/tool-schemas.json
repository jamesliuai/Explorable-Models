                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "remove"
                  },
                  "collection": {
                    "enum": [
                      "parameters",
                      "quantities",
                      "datasets",
                      "series"
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
