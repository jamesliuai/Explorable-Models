    "outputSchema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "data": {}
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "diagnostics"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 20,
