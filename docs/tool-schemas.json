[
  {
    "name": "visualization_discover",
    "description": "Get the v2 scope, limits, mutation guards, optional compact example, and honest capture/review availability.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeExample": {
          "type": "boolean"
        },
        "includeSchema": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "outputSchema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "data": {}
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "diagnostics"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "path",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "recovery": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  {
    "name": "visualization_create",
    "description": "Normalize and evaluate a declarative document as a candidate. Accepted state remains unchanged until commit. Schema/computation checks are author checks, not scientific review.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "object",
          "description": "VisualizationDocument 2.0. Call visualization_discover with includeSchema:true for the complete JSON Schema and field limits."
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "expectedVersion",
            "operationId"
          ],
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0
            },
            "expectedRunId": {
              "type": "string"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "origin": {
              "enum": [
                "human",
                "agent",
                "host"
              ]
            }
          }
        }
      },
      "required": [
        "document",
        "guard"
      ]
    },
    "outputSchema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "data": {}
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "diagnostics"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "path",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "recovery": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
