              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "removeView"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "id"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "setMark"
                  },
                  "viewId": {
                    "type": "string"
                  },
                  "mark": {
                    "type": "object"
                  }
                },
                "required": [
                  "op",
                  "viewId",
                  "mark"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "removeMark"
                  },
                  "viewId": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "viewId",
                  "id"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "presentation"
                  },
                  "value": {
                    "type": "object"
                  }
                },
                "required": [
                  "op",
                  "value"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "metadata"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "op"
                ]
              }
            ]
          }
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "expectedVersion",
            "operationId"
          ],
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 0
            },
            "expectedRunId": {
              "type": "string"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "origin": {
              "enum": [
                "human",
                "agent",
                "host"
              ]
            }
          }
        }
      },
      "required": [
